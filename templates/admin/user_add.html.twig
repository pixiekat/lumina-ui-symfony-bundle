{#
  Admin: create a user.

  `data-turbo="false"` is kept from the original. Symfony's form component
  re-renders the same URL with validation errors on failure, and Turbo would
  need the response to opt in before it displayed that; switching Turbo off for
  this subtree is the simplest way to keep server-side validation errors visible.
#}
{% extends '@LuminaUi/admin/layout.html.twig' %}
{% block admin_page_title %}Add User{% endblock %}

{% block content %}
  <div class="actions">
    <a href="{{ path('admin_users_list') }}" class="button button--secondary">&larr; Back to Users</a>
  </div>

  <div data-turbo="false">
    {{ form_start(form) }}
      {{ form_widget(form) }}
      <button type="submit">Add User</button>
    {{ form_end(form) }}
  </div>
{% endblock %}
