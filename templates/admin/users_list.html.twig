{% extends '@LuminaUi/layout.html.twig' %}
{% import '@LuminaUi/_links.html.twig' as links %}

{% block title %}Users List{% endblock %}

{% block body %}

  <h1>Users List</h1>

  <a href="{{ path('admin_user_add') }}" class="btn btn-primary mb-3">Add User</a>

  {% if users is defined %}
    <table class="table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Active</th>
          <th>Roles</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% if users is empty %}
          <tr>
            <td colspan="4">No users found.</td>
          </tr>
        {% else %}
          {% for user in users %}
            <tr>
              <td>{{ user.email }}</td>
              <td>{{ user.active ? 'Yes' : 'No' }}</td>
              <td>{{ user.roles|join(', ') }}</td>
              <td>
                <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-primary">Edit</a>
                <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                  <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
                </form>
                {#<a href="{{ path('admin_user_delete', {'id': user.id}) }}" class="btn btn-sm btn-danger">Delete</a>#}
              </td>
            </tr>
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}
