{#
  Admin: the user list.

  Now on @LuminaUi/admin/layout.html.twig and filling {% block content %}.

  ── What changed, and why it was a bug ─────────────────────────────────────
  This template used to extend the public layout and override {% block body %}.
  `body` is the block the layout uses to render the WHOLE page shell — skip
  link, header nav, <main> landmark, flash message region — so overriding it
  replaced all of that with just this table. One visible symptom: "User created
  successfully" never appeared here, because nothing on the page read the flash
  bag — the message then surfaced on whatever page was visited next, which reads
  as a bug rather than a confirmation. `content` is the hole a layout leaves for
  a page to fill; `body` is the layout itself.
#}
{% extends '@LuminaUi/admin/layout.html.twig' %}
{% block admin_page_title %}Users{% endblock %}

{% block content %}
  <div class="actions">
    <a href="{{ path('admin_user_add') }}" class="button">Add User</a>
  </div>

  <div class="table-wrap">
    <table>
      <caption>{{ users|length }} user{{ users|length == 1 ? '' : 's' }} with access to Lumina.</caption>
      <thead>
        <tr>
          <th scope="col">Email</th>
          <th scope="col">Active</th>
          <th scope="col">Roles</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {% for user in users|default([]) %}
          <tr>
            <th scope="row">{{ user.email }}</th>
            <td>
              {# The word carries it, not the colour. #}
              {% if user.active %}
                <span class="badge badge--agree">Yes</span>
              {% else %}
                <span class="badge badge--disagree">No</span>
              {% endif %}
            </td>
            <td>{{ user.roles|join(', ') }}</td>
            <td>
              {# Accessible names say WHICH user — a column of identical "Edit"
                 and "Delete" controls is unusable in a screen reader's list. #}
              <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="button button--secondary">
                Edit<span class="visually-hidden"> {{ user.email }}</span>
              </a>
              <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" class="inline"
                    onsubmit="return confirm('Delete {{ user.email }}? This cannot be undone.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                <button type="submit" class="button--danger">
                  Delete<span class="visually-hidden"> {{ user.email }}</span>
                </button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="4">No users found.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
