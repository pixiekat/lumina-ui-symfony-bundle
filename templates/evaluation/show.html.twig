{% extends '@LuminaUi/layout.html.twig' %}
{% import '@LuminaUi/_links.html.twig' as links %}
{% block page_title %}Evaluation #{{ evaluation.id }}{% endblock %}

{% block content %}
  {% set trialsManager = get_trials_manager() %}
  {#
    Guard the CALL, not just the display. `trialId` is null on every
    search_trials_for_patients row (they cover the whole catalogue, so there is
    no single trial), and TrialsManager::find() takes a non-nullable int. Twig's
    compiled templates run in coercive mode, but coercive mode still refuses
    null → int for a userland method: it raises a TypeError rather than quietly
    passing 0 or returning null. Unguarded, this line 500s the detail page for
    every search-kind evaluation.
  #}
  {% set trial = evaluation.trialId ? trialsManager.find(evaluation.trialId) : null %}
  <p><a href="{{ path('lumina_ui_evaluation_index') }}">&larr; All evaluations</a></p>

  <h1>
    Evaluation #{{ evaluation.id }}
    <span class="badge badge--{{ evaluation.status.value }}">{{ evaluation.status.label }}</span>
  </h1>

  <div class="actions">
    <a class="button button--secondary" href="{{ path('lumina_ui_evaluation_json', {id: evaluation.id}) }}">View JSON</a>
    <form method="post" action="{{ path('lumina_ui_evaluation_rerun', {id: evaluation.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('rerun-' ~ evaluation.id) }}">
      <button type="submit">Re-run</button>
    </form>
  </div>

  <table>
    <caption>Run details</caption>
    <tbody>
      <tr><th scope="row">Patient</th><td>
        {# evaluation.patientName ?? '—' }} ({{ links.external(ctomop_url, 'patient/' ~ evaluation.personId, evaluation.personId) }})#}
        <a href="{{ path('lumina_ui_patient_show', {personId: evaluation.personId}) }}">
          {{ evaluation.patientName ?? '—' }}
          <span class="muted">({{ links.external(ctomop_url, 'patient/' ~ evaluation.personId, evaluation.personId) }})</span>
        </a>
      </td></tr>
      <tr><th scope="row">Trial</th><td>
        {#
          The link needs the same guard as the lookup above, for a second
          reason: lumina_ui_trial_show requires trialId to match \d+, so
          generating it with null throws "Parameter must match \d+" — the URL
          generator refuses before the page ever renders.
        #}
        {% if evaluation.trialId %}
          <a href="{{ path('lumina_ui_trial_show', {trialId: evaluation.trialId}) }}">{{ trial.officialTitle ?? evaluation.trialId }}</a>
        {% else %}
          <span class="muted">All trials</span>
        {% endif %}
        {# evaluation.trialId ? links.external(exact_url, 'trials/trial/' ~ evaluation.trialId ~ '/change/', evaluation.trialId) : '—' #}
      </td></tr>
      <tr><th scope="row">Software</th><td>{{ evaluation.software.label }}</td></tr>
      <tr><th scope="row">Kind</th><td>{{ evaluation.kind.label }}</td></tr>
      {% if evaluation.batch %}
        <tr><th scope="row">Batch</th>
          <td><a href="{{ path('lumina_ui_batch_show', {id: evaluation.batch.id}) }}">#{{ evaluation.batch.id }}</a></td></tr>
      {% endif %}
      <tr><th scope="row">Created</th><td>{{ evaluation.createdAt|date('Y-m-d H:i:s') }}</td></tr>
      <tr><th scope="row">Ran at</th>
        <td>{{ evaluation.ranAt ? evaluation.ranAt|date('Y-m-d H:i:s') : '—' }}
          {%- if evaluation.durationMs %} <span class="muted">({{ evaluation.durationMs }} ms)</span>{% endif %}</td></tr>
      <tr><th scope="row">Clintrials.gov Link</th><td>
        {% if trial and trial.link %}
          <a href="{{ trial.link }}" target="_blank" rel="noopener noreferrer">{{ trial.studyId }}</a>
        {% else %}
          <span class="muted">—</span>
        {% endif %}
    </tbody>
  </table>

  {% if evaluation.summary %}
    {#<h2>Summary</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          {% for key, value in evaluation.summary %}
            <tr><th scope="row">{{ key }}</th><td>{{ value ?? '—' }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>#}
  {% endif %}

  {% if evaluation.attributes %}
    <h2>Trial match breakdown ({{ evaluation.attributes|length }})</h2>

    {#
      A row of stat tiles, deliberately NOT a chart. Three headline numbers is
      the textbook case for this form — a three-bar bar chart would add an axis,
      gridlines and a legend to communicate the same three integers, and would
      invite reading the bar lengths as a proportion they were never scaled to be.

      ── Why the numbers are plain ink and the colour is only a rule ───────────
      Green-vs-red is the classic colour-vision-deficiency collision, and it is
      not close: measured at ΔE 3.7 under deuteranopia against a floor of 8. For
      a deutan reader, a red "2" and a green "82" are the same colour. So hue
      cannot be allowed to carry the meaning here — the WORD under each figure
      does, and the 3px top rule plus the icon are redundant confirmation for
      people who can use them. This is also why the value itself stays in normal
      text ink: a number printed in red states its meaning twice for sighted
      users and not at all for a screen reader.

      ── Two smaller deliberate choices ───────────────────────────────────────
      The icons are aria-hidden: the visible label already says "Not matched",
      and without it a screen reader announces "cross mark Not matched".
      And <dl> is the honest element for label/value pairs — the CSS flips each
      tile visually so the number sits on top, while the DOM keeps the reading
      order ("Matched, 82") that a screen reader needs.
    #}
    {% set tiles = [
      {label: 'Matched',     count: evaluation.matchedCount,    modifier: 'matched',    icon: '✅'},
      {label: 'Not matched', count: evaluation.notMatchedCount, modifier: 'notmatched', icon: '❌'},
      {label: 'Unknown',     count: evaluation.unknownCount,    modifier: 'unknown',    icon: '?'},
    ] %}
    <dl class="kpi-row">
      {% for tile in tiles %}
        <div class="kpi kpi--{{ tile.modifier }}">
          <dt class="kpi-label"><span aria-hidden="true">{{ tile.icon }}</span> {{ tile.label }}</dt>
          <dd class="kpi-value">{{ tile.count }}</dd>
        </div>
      {% endfor %}
    </dl>

    <div class="table-wrap">
      <table>
        <caption>Shows whether or not the patient matched the trial attribute criteria for this trial.</caption>
        <thead>
          <tr>
            <th scope="col">Trial Match Attribute</th>
            <th scope="col">Matched?</th>
            <th scope="col">Patient Value</th>
          </tr>
        </thead>
        <tbody>
          {% for attr in evaluation.attributes %}
            <tr>
              <td>{{ attr.name }}</td>
              <td>
                {% if attr.status == 'matched' %}
                  <span class="badge bg-success">Matched</span>
                {% elseif attr.status == 'not_matched' %}
                  <span class="badge bg-danger">Not Matched</span>
                {% else %}
                  <span class="badge bg-secondary">Unknown</span>
                {% endif %}
              </td>
              <td>{{ attr.ctomop ?? '—' }}</td>
              <!--<td>{{ attr.differs ? 'yes' : 'no' }}</td>-->
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if evaluation.rawOutput %}
    <h2>Raw output</h2>
    <details>
      <summary>Show captured stdout</summary>
      <pre>{{ evaluation.rawOutput }}</pre>
    </details>
  {% endif %}

  {% if evaluation.command %}
    <h2>Command</h2>
    <pre>{{ evaluation.command }}</pre>
  {% endif %}
{% endblock %}
