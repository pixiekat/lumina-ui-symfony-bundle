{#
  Shared layout for the Lumina UI screens. Extends the host app's base.html.twig
  so it inherits importmap/asset wiring, and provides an accessible shell:
  a skip link, landmark regions, flash messages, and a small high-contrast
  stylesheet. Pages override {% block page_title %} and {% block content %}.
#}
{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}Lumina UI{% endblock %} · Lumina{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root { --fg:#1a1a1a; --muted:#5a5a5a; --line:#cfcfcf; --bg:#ffffff; --accent:#0b5fff; }
    body { color:var(--fg); background:var(--bg); font:1rem/1.5 system-ui, sans-serif; margin:0; }
    main { max-width:72rem; margin:0 auto; padding:1.5rem clamp(1rem, 3vw, 2rem); }
    a { color:var(--accent); }
    :focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
    .skip-link { position:absolute; left:-999px; top:0; background:var(--bg); padding:.5rem 1rem; }
    .skip-link:focus { left:.5rem; top:.5rem; z-index:10; }
    header { border-bottom:1px solid var(--line); }
    header nav { max-width:72rem; margin:0 auto; padding:.75rem clamp(1rem,3vw,2rem); display:flex; gap:1.25rem; }
    h1 { font-size:1.6rem; margin:0 0 1rem; }
    .actions { display:flex; flex-wrap:wrap; gap:.75rem; margin:0 0 1.25rem; }
    .muted { color:var(--muted); }
    .table-wrap { overflow-x:auto; }
    table { border-collapse:collapse; width:100%; }
    caption { text-align:left; color:var(--muted); padding:.25rem 0 .5rem; }
    th, td { text-align:left; padding:.5rem .65rem; border-bottom:1px solid var(--line); vertical-align:top; }
    thead th { border-bottom:2px solid var(--line); white-space:nowrap; }
    tbody tr:hover { background:#f5f7ff; }
    /* Status badge: never colour-only — the text label always carries meaning. */
    .badge { display:inline-block; padding:.1rem .5rem; border-radius:.5rem; border:1px solid; font-size:.85rem; }
    .badge--pending   { background:#fff7e6; border-color:#d9a300; color:#7a5b00; }
    .badge--running   { background:#e6f0ff; border-color:#0b5fff; color:#003bb3; }
    .badge--completed { background:#e7f6ec; border-color:#1a8a44; color:#0c5a2b; }
    .badge--failed    { background:#fdeaea; border-color:#c0392b; color:#8a261b; }
    .flash { padding:.65rem 1rem; border:1px solid var(--line); border-radius:.4rem; margin:0 0 1rem; }
    .flash--success { background:#e7f6ec; border-color:#1a8a44; }
    .flash--error   { background:#fdeaea; border-color:#c0392b; }
    button, .button { font:inherit; padding:.4rem .8rem; border:1px solid var(--accent); border-radius:.4rem;
                      background:var(--accent); color:#fff; cursor:pointer; text-decoration:none; display:inline-block; }
    .button--secondary, form.inline button { background:transparent; color:var(--accent); }
    form.inline { display:inline; }
    pre { background:#f4f4f4; padding:1rem; overflow-x:auto; border:1px solid var(--line); border-radius:.4rem; }
    .field { margin:0 0 1rem; max-width:24rem; }
    .field label { display:block; font-weight:600; margin-bottom:.25rem; }
    .field input { font:inherit; padding:.45rem .6rem; width:100%; border:1px solid var(--line); border-radius:.4rem; }
    .pagination { display:flex; gap:1rem; align-items:center; margin:1rem 0; }
    /* Visible to screen readers, invisible on screen. Used to give repeated
       controls ("Queue", "Select") a distinguishable accessible name — a list of
       thirty identically-named buttons is unusable in a screen reader. Clip
       rather than display:none, which would remove it from the a11y tree too. */
    .visually-hidden { position:absolute; width:1px; height:1px; margin:-1px; padding:0;
                       overflow:hidden; clip:rect(0 0 0 0); clip-path:inset(50%); white-space:nowrap; border:0; }
    .trial-summary { border:1px solid var(--line); border-radius:.4rem; padding:1rem; margin:0 0 1.25rem; }
    .trial-summary h2 { font-size:1.15rem; margin:0 0 .75rem; }
    /* Auto-fit rather than a fixed column count, so the definition list reflows
       to one column on a narrow screen instead of overflowing. */
    .trial-meta { display:grid; grid-template-columns:repeat(auto-fit, minmax(12rem, 1fr));
                  gap:.5rem 1.5rem; margin:0; }
    .trial-meta dt { font-weight:600; font-size:.85rem; color:var(--muted); }
    .trial-meta dd { margin:0; }
    .status-summary { margin:0 0 .75rem; }
    /* KPI row — a handful of headline numbers, the one case where the right
       "chart" is no chart at all. auto-fit rather than a fixed 3 columns so the
       tiles reflow to one column on a phone instead of squeezing. */
    .kpi-row { display:grid; grid-template-columns:repeat(auto-fit, minmax(9rem, 1fr));
               gap:.75rem; margin:0 0 1.25rem; }
    /* column-reverse puts the VALUE on top visually while the DOM keeps
       <dt> before <dd> — correct markup and correct reading order, both. */
    .kpi { display:flex; flex-direction:column-reverse; align-items:center;
           border:1px solid var(--line); border-top:3px solid var(--muted);
           border-radius:.4rem; padding:.9rem .75rem; text-align:center; }
    /* The status hue lives ONLY here. Green and red are indistinguishable under
       deuteranopia (measured ΔE 3.7, floor 8), so this rule is a redundant cue
       on top of the text label — never the thing carrying the meaning. */
    .kpi--matched    { border-top-color:#1a8a44; }
    .kpi--notmatched { border-top-color:#c0392b; }
    .kpi--unknown    { border-top-color:var(--muted); }
    /* Proportional figures on purpose: tabular-nums gives every digit the width
       of a 0, which reads loose at display sizes. Save it for table columns. */
    .kpi-value { margin:0; font-size:2.5rem; font-weight:600; line-height:1.1; color:var(--fg); }
    .kpi-label { margin-top:.15rem; color:var(--muted); font-size:.9rem; }
    /* Zebra striping helps eyes track across a wide row; kept subtle enough not
       to fight the hover state or the badge colours. */
    tbody tr:nth-child(even) { background:#fafafa; }
    tbody tr:hover { background:#f5f7ff; }

    /* ── Evaluator reviews ──────────────────────────────────────────────────
       Verdict badges reuse the .badge base. As everywhere else in this
       stylesheet the hue is a redundant cue only: every badge spells out
       "Agree" or "Disagree" in words, because these two are the green/red pair
       that collapses to one colour under deuteranopia. Deliberately the same
       greens and reds as the completed/failed status badges rather than a new
       pair — one palette, fewer colours to tell apart. */
    .badge--agree    { background:#e7f6ec; border-color:#1a8a44; color:#0c5a2b; }
    .badge--disagree { background:#fdeaea; border-color:#c0392b; color:#8a261b; }
    /* The banner under the <h1>. Left rule rather than a filled panel: it marks
       the block as a distinct kind of content without competing with the flash
       messages sitting directly above it. */
    .review-summary { border-left:4px solid var(--accent); background:#f7f9ff;
                      padding:.75rem 1rem; border-radius:.4rem; margin:0 0 1.25rem; }
    .review-summary h2 { font-size:1.05rem; margin:0 0 .35rem; }
    .review-summary p { margin:.25rem 0; }
    .review-tally { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; }
    .review-mine { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; }
    /* The form. Radios stack rather than sitting inline: a vertical list is
       easier to hit accurately, which matters more than the horizontal space it
       costs — and the label wraps the input, so the whole line is a click target
       rather than just the 13px circle. */
    .review-form { border-top:1px solid var(--line); margin:2rem 0 0; padding:1.5rem 0 0; }
    .review-verdict { border:1px solid var(--line); border-radius:.4rem;
                      padding:.75rem 1rem; margin:0 0 1rem; max-width:32rem; }
    .review-verdict legend { font-weight:600; padding:0 .35rem; }
    .review-option { display:flex; gap:.5rem; align-items:baseline; padding:.35rem 0; cursor:pointer; }
    /* Match the .field input rule the layout already defines, so a select and a
       textarea do not sit at a different size from the inputs beside them. */
    .field select, .field textarea { font:inherit; padding:.45rem .6rem; width:100%;
                                     border:1px solid var(--line); border-radius:.4rem; }
    .field { max-width:32rem; }
    .field-help { font-size:.85rem; margin:.25rem 0 0; }
    .review-reason-help { margin:.5rem 0 0; font-size:.9rem; }
    .review-reason-help dt { font-weight:600; margin-top:.4rem; }
    .review-reason-help dd { margin:0 0 .25rem; color:var(--muted); }
    /* The comment list. Each review is a card with a left rule, echoing the
       summary banner so the two read as the same feature at opposite ends of
       the page. */
    .review-list { margin:2rem 0 0; }
    .review { border:1px solid var(--line); border-left:4px solid var(--line);
              border-radius:.4rem; padding:.75rem 1rem; margin:0 0 .75rem; }
    /* Your own review, marked by weight and not by colour alone — the "(you)"
       in the byline is what actually carries it. */
    .review--mine { border-left-color:var(--accent); background:#f7f9ff; }
    .review-byline { font-size:1rem; margin:0 0 .25rem; display:flex;
                     flex-wrap:wrap; gap:.5rem; align-items:baseline; }
    .review-meta { font-size:.85rem; margin:0 0 .5rem; }
    .review-comment { margin:0; white-space:normal; }
  </style>
{% endblock %}

{% block body %}
  <a class="skip-link" href="#main">Skip to content</a>
  <header>
    <nav aria-label="Primary">
      <a href="{{ path('lumina_ui_trial_index') }}">Trials</a>
      <a href="{{ path('lumina_ui_patient_index') }}">Patients</a>
      <a href="{{ path('lumina_ui_evaluation_index') }}">Evaluations</a>
      {% if constant('Pixiekat\\LuminaUiBundle\\Interfaces\\Security\\Voter\\GenericVoterInterface::CAN_ACCESS_ADMIN_PANEL') %}
        <a href="{{ path('admin_index') }}">Admin</a>
      {% endif %}
      {# <a href="{{ path('lumina_ui_batch_index') }}">Search Trials for Patient Eligibility</a> #}
      {#{% if exact_url is defined %}
        <a href="{{ exact_url }}" rel="noopener noreferrer" target="_blank">Exact Admin (external)</a>
      {% endif %}
      {% if ctomop_url is defined %}
        <a href="{{ ctomop_url }}" rel="noopener noreferrer" target="_blank">CTOMOP (external)</a>
      {% endif %}#}
    </nav>
  </header>
  <main id="main">
    {% for label, messages in app.flashes(['success', 'error', 'info', 'danger']) %}
      {% for message in messages %}
        {% set type = label == 'error' ? 'alert' : 'status' %}
        <p class="flash flash--{{ label }}" role="{{ type }}">{{ message }}</p>
      {% endfor %}
    {% endfor %}
    {% block content %}{% endblock %}
  </main>
{% endblock %}
